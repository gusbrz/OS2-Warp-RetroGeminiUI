# ---- Gemini (obrigatorio para gerar planos de campanha) ----
GEMINI_API_KEY=

# ---- Agente direto Google Ads (publicacao real de campanhas) ----
# 1. Developer token: conta de administrador (MCC) Google Ads → Ferramentas → Central de APIs
GOOGLE_ADS_DEVELOPER_TOKEN=
# 2. ID da conta Google Ads onde as campanhas serao criadas (10 digitos, com ou sem hifens)
GOOGLE_ADS_CUSTOMER_ID=
# 3. (Opcional) ID da conta de administrador (MCC) que gerencia a conta acima
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# 4. Cliente OAuth 2.0 (tipo "Aplicativo da Web") no Google Cloud Console,
#    escopo https://www.googleapis.com/auth/adwords
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 5. Preenchido automaticamente apos a conexao OAuth pelo botao "Conectar conta Google".
#    Tambem pode ser gerado manualmente (OAuth Playground) e colado aqui.
GOOGLE_ADS_REFRESH_TOKEN=
# 6. (Opcional) Versao da API do Google Ads. Padrao: v24 (suportada ate ~mai/2027).
GOOGLE_ADS_API_VERSION=v24
